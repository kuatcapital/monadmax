# Alchemy API key (alchemy.com -> Create App -> network: Monad)
VITE_ALCHEMY_KEY=

# CoinMarketCap API key (pro.coinmarketcap.com). No VITE_ prefix on purpose:
# it stays on the dev server (proxy) and is never sent to the browser.
CMC_API_KEY=

# WalletConnect Project ID (free at cloud.reown.com) — enables mobile wallets (QR / deep link)
VITE_WALLETCONNECT_PROJECT_ID=

# Official public URL of MonadMax (e.g. https://monadmax.xyz) — used in every shared link
VITE_SITE_URL=

# Server-only Alchemy key (no VITE_ prefix → never sent to the browser).
# Use a SECOND Alchemy app for this. The VITE_ key above is public by
# nature — restrict it to your domain in the Alchemy dashboard.
ALCHEMY_SERVER_KEY=
